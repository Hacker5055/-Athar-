<receiver
    android:name=".AtharWidgetProvider"
    android:exported="true"
    android:label="@string/athar_widget_description">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>

    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/athar_widget_info" />
</receiver>
