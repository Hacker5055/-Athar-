<?xml version="1.0" encoding="utf-8"?>
<!--
  ودجت أثر — الشاشة الرئيسية.

  التصميم مقصود إنه **بسيط وثابت**: RemoteViews في أندرويد لا تدعم
  أي عنصر مخصّص، ولا خطوط مرفقة، ولا قياسات ديناميكية. لذلك:
  - خط النظام فقط (لا نستطيع استخدام Amiri هنا).
  - لا دوائر تقدّم ولا SVG — مستطيلات وألوان ثابتة.
  - كل الألوان من res/values/colors.xml (تُنسخ مع الملف).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/athar_widget_bg"
    android:padding="14dp">

    <!-- المكان -->
    <TextView
        android:id="@+id/widget_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8C9C96"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- الصلاة القادمة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#12211D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#0F6E5C"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- العدّ التنازلي -->
    <TextView
        android:id="@+id/widget_next_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#5C6F69"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <!-- الخط الفاصل -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E7DFD2"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <!-- المواقيت المختصرة -->
    <TextView
        android:id="@+id/widget_times"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#3F5450"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
