<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ لماذا FileProvider؟

  مشاركةُ صورةِ الملخّص (F6) تعني تسليمَ الملفّ إلى تطبيقٍ آخر.
  ومنذ أندرويد ٧ لا يُشارَك مسارٌ من الملفّ مباشرةً — فيسقط
  التطبيقُ بخطأ «FileUriExposedException». وFileProvider يعطي
  `content://` بدل `file://`، مع إذنٍ مؤقّتٍ للقراءة وحده.

  ⚠️ والمجلّد `cache/` **لا يحتاج إذنًا**: التطبيقُ وحده يقرؤه،
  ولا يُمسح إلا حين ينظّف النظامُ التخزين. فالصورةُ المؤقّتةُ
  للمشاركة تُحفظ هناك لا في `files/`.
-->
<paths>
    <cache-path
        name="shared"
        path="shared/" />
</paths>
