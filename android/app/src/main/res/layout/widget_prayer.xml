<?xml version="1.0" encoding="utf-8"?>
<!-- ⚠️ RemoteViews لا يقبل إلا عددًا محدودًا من المكوّنات:
     LinearLayout وTextView وChronometer ImageView. لا ConstraintLayout
     ولا أي مكوّن مخصّص. وكل معرّف يُقرأ من الكود. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="locale"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/athar_mint" />

        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/athar_cream" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/athar_mint" />

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/athar_gold" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/athar_cream" />
    </LinearLayout>

    <!-- ⚠️ الصلوات الخمس كما هي في اليوم لا «القادمة وحدها»: من
         يريد أن يعرف وقت العشاء لا ينتظر أن يصير هو القادم. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_fajr_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/athar_mint" />
            <TextView android:id="@+id/widget_fajr_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/athar_cream" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_dhuhr_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/athar_mint" />
            <TextView android:id="@+id/widget_dhuhr_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/athar_cream" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_asr_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/athar_mint" />
            <TextView android:id="@+id/widget_asr_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/athar_cream" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_maghrib_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/athar_mint" />
            <TextView android:id="@+id/widget_maghrib_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/athar_cream" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_isha_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/athar_mint" />
            <TextView android:id="@+id/widget_isha_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/athar_cream" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
